# Copy to .env.local. Never commit actual API keys.
# Resend is used only for magic-link sign-in; OpenShelf needs no LLM API key.
RESEND_API_KEY=replace_with_your_resend_key
ALLOWED_EMAILS=you@example.com
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Local DATABASE_URL is configured by mise. Set this yourself without mise,
# or configure your production Postgres URL in your deployment environment.
# DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
